 "answer": {
  "text": "This counts distinct clients who are the OWNER of an account that has both a loan and a standing order for an insurance premium (k_symbol = POJISTNE).",
  "sql": "SELECT COUNT(DISTINCT c.client_id)\nFROM client c\nJOIN disp d ON d.client_id = c.client_id AND d.type = 'OWNER'\nJOIN account a ON a.account_id = d.account_id\nJOIN loan l ON l.account_id = a.account_id\nJOIN \"order\" o ON o.account_id = a.account_id AND o.k_symbol = 'POJISTNE'",
  "declined": false,
  "decline_reason": null,
  "clarifying_question": "Should \"own\" include only account owners (OWNER disposition) or also authorized users (DISPONENT)?",
  "assumptions": [
   "\"Own\" means the client has the OWNER disposition on the account (not a DISPONENT).",
   "\"Standing order for an insurance premium\" means order.k_symbol = 'POJISTNE'.",
   "A client is counted once even if they own multiple qualifying accounts."
  ],
  "premise_correction": null
 },
