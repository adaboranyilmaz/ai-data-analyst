# Copy to .env and fill in what you need. .env is never committed.
# Every value may stay empty: the code and docker-compose.yml fall back to local defaults.

# Anthropic API key, for live runs only. Without it, recorded responses are replayed.
ANTHROPIC_API_KEY=

# 1 = every model response must come from the on-disk cache: a cache miss is an error,
# never an API call. CI and pipeline rebuilds set it.
ANALYST_REPLAY_ONLY=

# PostgreSQL in docker compose. Empty values use the local-only defaults in
# docker-compose.yml; the database is bound to 127.0.0.1 and holds public benchmark data.
POSTGRES_PASSWORD=
ANALYST_RO_PASSWORD=
ANALYST_DB_PORT=

# Ollama host, if not the default http://localhost:11434.
OLLAMA_HOST=

# MLflow tracking backend; empty means the local SQLite store sqlite:///mlflow.db.
MLFLOW_TRACKING_URI=
